rules_version = '2';

// MeetBook Firestore Security Rules — complete and self-contained.
// Deploy by pasting this file into Firebase Console -> Firestore Database ->
// Rules (Spark plan), or with `firebase deploy --only firestore:rules`.
//
// Enforcement model:
//  - A request is "signed in" when request.auth != null.
//  - A user is an ADMIN when their users/{uid} document has role == 'admin'
//    (checked server-side here via get(), and again in Cloud Functions —
//    never by frontend code alone).
//  - Bot collections are writable only by admins from the client; the real
//    bot engine writes with the Admin SDK from Cloud Functions, which
//    bypasses these rules under controlled backend permissions.
//  - PROVABLE QUERIES: Firestore denies a list query unless the rules are
//    provable from the query's own constraints ("rules are not filters"),
//    so READ rules for client-listened collections (posts, messages,
//    friendships, groups, conversations) only test fields stored on the
//    document itself against request.auth — never get()/exists() joins.
//    Audiences are denormalized onto documents at write time to make
//    that possible (posts.audienceIds, messages.participants). get() is
//    still used on single-document writes, where it is allowed.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.get('role', 'user') == 'admin';
    }
    // ------------------------------------------------------------ users
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('isBot', false) == false;
      // Users may edit their own profile, but may not grant themselves a
      // role or turn themselves into a bot — those fields are admin-only.
      allow update: if (isSelf(uid)
          && request.resource.data.get('role', 'user') == resource.data.get('role', 'user')
          && request.resource.data.get('isBot', false) == resource.data.get('isBot', false))
        || isAdmin();
      allow delete: if isSelf(uid) || isAdmin();
    }

    // ------------------------------------------------------------ blocks
    // Document id convention: {by}_{target}
    match /blocks/{blockId} {
      allow read: if signedIn() && (resource.data.by == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
      allow update: if false;
    }

    // ------------------------------------------------------- friendships
    match /friendships/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid || isAdmin());
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdmin());
    }

    // ------------------------------------------------------------ posts
    // The read rule is deliberately PROVABLE from the client's queries
    // (authorId == me / visibility == 'public' / audienceIds contains
    // me): it only inspects fields stored on the post itself. The
    // audience is denormalized at creation time (see postAudience in
    // src/utils.js):
    //  - public posts — including page posts and public-group posts —
    //    store visibility 'public' and are readable by anyone signed in.
    //  - friends posts store audienceIds = the author's friends then.
    //  - private-group posts store visibility 'private' and
    //    audienceIds = the group's members at creation time.
    // Blocked-author hiding is enforced client-side (the UI filters
    // blocked authors out of every list), not in this rule.
    match /posts/{postId} {
      allow read: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || isAdmin()
        || resource.data.get('visibility', 'public') == 'public'
        || request.auth.uid in resource.data.get('audienceIds', [])
      );
      // Page posts (pageId set) follow the normal path: authorId is the
      // page owner's uid, so authorship checks work unchanged. Group posts
      // additionally require group membership at creation time.
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.get('likes', []).size() == 0
        && (request.resource.data.get('groupId', '') == ''
            || (exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
                && request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.get('members', [])));
      // Author edits content; any signed-in reader may update engagement
      // arrays (likes/reactions/savedBy/shares/comments) but NOT authorship,
      // the post body, its group/page assignment, or its audience —
      // enforced by the field pins below.
      allow update: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid)
        || (signedIn()
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.text == resource.data.text
            && request.resource.data.image == resource.data.image
            && request.resource.data.visibility == resource.data.visibility
            && request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
            && request.resource.data.get('pageId', '') == resource.data.get('pageId', '')
            && request.resource.data.get('audienceIds', []) == resource.data.get('audienceIds', []));
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ----------------------------------------------------------- stories
    // Stories are photo/text only and live for 24 hours (expiry is a
    // client-side filter on createdAt; the rules govern access). The
    // read rule uses the same PROVABLE shape as posts — the audience is
    // denormalized at creation (friends stories snapshot the author's
    // friend ids into audienceIds), so the client's three listeners
    // (public / authorId == me / audienceIds contains me) are allowed.
    match /stories/{storyId} {
      allow read: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || isAdmin()
        || resource.data.get('visibility', 'public') == 'public'
        || request.auth.uid in resource.data.get('audienceIds', [])
      );
      // A story starts life with an empty views list — nobody can
      // pre-populate viewers.
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.get('views', []).size() == 0;
      // The author (and admins) manage the story; anyone else signed in
      // may ONLY append their own uid to views — the diff pins every
      // other field, the hasAll + size + membership checks make it an
      // append of exactly the caller's uid, mirroring the groups/pages
      // membership-update pattern.
      allow update: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.get('views', []).hasAll(resource.data.get('views', []))
            && request.resource.data.get('views', []).size() == resource.data.get('views', []).size() + 1
            && request.auth.uid in request.resource.data.get('views', [])
            && !(request.auth.uid in resource.data.get('views', [])));
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ------------------------------------------------------------ groups
    // Membership lives on the group document (members array, creator in
    // createdBy). Public groups are readable by any signed-in user;
    // private groups only by members, the creator and admins. The creator
    // manages the group (edit info, remove members, delete); a non-creator
    // may only add/remove THEMSELVES through a members-only update.
    match /groups/{groupId} {
      allow read: if signedIn()
        && (resource.data.get('privacy', 'public') == 'public'
            || request.auth.uid in resource.data.get('members', [])
            || resource.data.createdBy == request.auth.uid
            || isAdmin());
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.get('members', []);
      allow update: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.createdBy == resource.data.createdBy
            && ((request.auth.uid in request.resource.data.get('members', [])
                 && !(request.auth.uid in resource.data.get('members', []))
                 && request.resource.data.get('members', []).size() == resource.data.get('members', []).size() + 1)
                || (!(request.auth.uid in request.resource.data.get('members', []))
                 && request.auth.uid in resource.data.get('members', [])
                 && request.resource.data.get('members', []).size() == resource.data.get('members', []).size() - 1)));
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ------------------------------------------------------------- pages
    // Pages are public: any signed-in user can read and follow one. Only
    // the owner edits page info or deletes the page; a non-owner may only
    // add/remove THEMSELVES through a followers-only update.
    match /pages/{pageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
            && request.resource.data.ownerId == resource.data.ownerId
            && ((request.auth.uid in request.resource.data.get('followers', [])
                 && !(request.auth.uid in resource.data.get('followers', []))
                 && request.resource.data.get('followers', []).size() == resource.data.get('followers', []).size() + 1)
                || (!(request.auth.uid in request.resource.data.get('followers', []))
                 && request.auth.uid in resource.data.get('followers', [])
                 && request.resource.data.get('followers', []).size() == resource.data.get('followers', []).size() - 1)));
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------- conversations
    // 1-1 chats have exactly 2 participants; GROUP chats (isGroup) have
    // 2+ and must name their creator (createdBy == caller).
    match /conversations/{convId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && (request.resource.data.get('isGroup', false) == false
            || request.resource.data.get('createdBy', '') == request.auth.uid);
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------- messages
    // Participants are denormalized onto each message at send time, so
    // the read rule (and the client's participants array-contains
    // listener) is provable from the document itself — no get() join to
    // the conversation. Creation still verifies membership against the
    // conversation document (single-doc writes may use get()).
    match /messages/{msgId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.get('participants', []) || isAdmin());
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in request.resource.data.get('participants', [])
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;
      // Only read receipts / status may change after sending; the text,
      // the sender and the participant set are pinned.
      allow update: if signedIn() && request.auth.uid in resource.data.get('participants', [])
        && request.resource.data.text == resource.data.text
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.get('participants', []) == resource.data.get('participants', []);
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------- events
    // Mirrors the posts rule: the audience is denormalized at creation
    // (postAudience), so the read rule is PROVABLE from the client's
    // three listeners (visibility == 'public' / createdBy == me /
    // audienceIds contains me) — it only inspects fields on the event
    // itself. RSVP updates ride an engagement branch that pins every
    // content/audience field and leaves only going/interested writable.
    match /events/{eventId} {
      allow read: if signedIn() && (
        resource.data.createdBy == request.auth.uid
        || isAdmin()
        || resource.data.get('visibility', 'public') == 'public'
        || request.auth.uid in resource.data.get('audienceIds', [])
      );
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid)
        || (signedIn()
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.title == resource.data.title
            && request.resource.data.description == resource.data.description
            && request.resource.data.dateTime == resource.data.dateTime
            && request.resource.data.location == resource.data.location
            && request.resource.data.cover == resource.data.cover
            && request.resource.data.visibility == resource.data.visibility
            && request.resource.data.get('audienceIds', []) == resource.data.get('audienceIds', []));
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ----------------------------------------------------------- reviews
    // Page reviews are public to signed-in users. The read rule is
    // deliberately field-INDEPENDENT (signedIn only) so the client's
    // where('pageId', '==', X) list query stays provable. One review per
    // user per page is a client-level invariant (the app upserts).
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if signedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin())
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.pageId == resource.data.pageId
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ----------------------------------------------------- groupRequests
    // Join requests for PRIVATE groups. groupOwnerId (the group creator)
    // is denormalized onto the request at creation, so both list queries
    // the client runs — where('userId','==',me) for "my requests" and
    // where('groupOwnerId','==',me) for the creator's queue — are
    // provable from the request document's own fields.
    match /groupRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
            || resource.data.groupOwnerId == request.auth.uid
            || isAdmin());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Only the group owner (or an admin) decides; the pinned fields
      // keep the request's identity intact — only status may change.
      allow update: if signedIn()
        && (resource.data.groupOwnerId == request.auth.uid || isAdmin())
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.groupOwnerId == resource.data.groupOwnerId;
      // The requester may withdraw their own request.
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid
            || resource.data.groupOwnerId == request.auth.uid
            || isAdmin());
    }

    // ----------------------------------------------------- notifications
    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ----------------------------------------------------------- reports
    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------- bots
    // Bot profiles are publicly readable (they are labelled AI accounts);
    // all writes are admin-only from clients. The bot engine itself runs in
    // Cloud Functions with the Admin SDK.
    match /bots/{botId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /botBrains/{botId} {
      allow read, write: if isAdmin();
    }
    match /botMemories/{botId} {
      allow read, write: if isAdmin();
    }
    match /botConversations/{id} {
      allow read, write: if isAdmin();
    }
    match /botActivities/{id} {
      allow read: if isAdmin();
      allow write: if false; // written by Functions (Admin SDK) only
    }
    match /botRunners/{id} {
      allow read, write: if isAdmin();
    }
    match /botSettings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /botLogs/{id} {
      allow read: if isAdmin();
      allow write: if false; // written by Functions (Admin SDK) only
    }

    // ------------------------------------------------------------- config
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
