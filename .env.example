# MeetBook Firebase web configuration — OPTIONAL overrides.
# The app ships with the public Firebase web config for project
# "meetbook-d8a44" as its default (src/firebase-config.js), so it runs in
# LIVE Firebase mode out of the box. Set these only to point the build at a
# different Firebase project. A Firebase web config is not a secret; access
# is controlled by Firebase Auth + Security Rules. Never put real secrets
# (service accounts, AI provider keys) in frontend env vars.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=meetbook-d8a44
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Making an admin: seed the user's users/{uid} document with role: "admin"
# from the Firebase Console. Cloud Functions (setUserRole) and the security
# rules enforce admin rights server-side; the UI check alone is never used.
